/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/aplikasi/*.exe
  Content-Type: application/octet-stream
  Content-Disposition: attachment

/aplikasi/release.json
  Cache-Control: no-store

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/pembaruan.html
  Cache-Control: no-cache

/aplikasi/download-verification.json
  Cache-Control: no-store

/app.js
  Cache-Control: no-cache

/release-download.js
  Cache-Control: no-cache

/updates.js
  Cache-Control: no-cache

/intro.js
  Cache-Control: no-cache

/logo-anim/*.webp
  Content-Type: image/webp
